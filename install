#!/bin/sh 

#---------------------------------------------------------------------
#
# The following assigns must be changed according to your system
#

GCC=gcc
GPP="g++"

XLIB=/usr/X11R6/lib

#
#--------------------------------------------------------------------

CFLAGS="${CFLAGS:--O2 -fexpensive-optimizations -finline-functions}"
CMP="$GPP $CFLAGS -c"

LFLAGS="-lX11 -lm -L$XLIB"



echo color_trans   ; $CMP color_trans.cc
echo xtimer        ; $CMP xtimer.cc        
echo option_menu   ; $CMP option_menu.cc   
echo setupedit     ; $CMP setupedit.cc     
echo robot         ; $CMP robot.cc         
echo land          ; $CMP land.cc          
echo ship          ; $CMP ship.cc          
echo building      ; $CMP building.cc      
echo dir           ; $CMP dir.cc           
echo object_handler; $CMP object_handler.cc 
echo pic           ; $CMP pic.cc           
echo player        ; $CMP player.cc        
echo field         ; $CMP field.cc         
echo ilfield       ; $CMP ilfield.cc       
echo xbm           ; $CMP xbm.cc           
echo cmap_edit     ; $CMP cmap_edit.cc     
echo cmap          ; $CMP cmap.cc          
echo ppm           ; $CMP ppm.cc           
echo compress      ; $CMP compress.cc      
echo table         ; $CMP table.cc         
echo xmath         ; $CMP xmath.cc         
echo io            ; $CMP io.cc            
echo cry           ; $CMP cry.cc           
echo win           ; $CMP win.cc           
echo dial          ; $CMP dial.cc          
echo multi_dial    ; $CMP multi_dial.cc    
echo menu          ; $CMP menu.cc          
echo xsystem       ; $CMP xsystem.cc       
echo xfile         ; $CMP xfile.cc         
echo ppm_handler   ; $CMP ppm_handler.cc   
echo errorhandling ; $CMP errorhandling.cc 
echo paramreader   ; $CMP paramreader.cc   
echo pattern_match ; $CMP pattern_match.cc 
echo objects       ; $CMP objects.cc       
echo xstring       ; $CMP xstring.cc       
echo id_handler    ; $CMP id_handler.cc    
echo masks         ; $CMP masks.cc         
echo buttons       ; $CMP buttons.cc       
echo lru           ; $CMP lru.cc           
echo scroller      ; $CMP scroller.cc      
echo selector      ; $CMP selector.cc      
echo cmap_selector ; $CMP cmap_selector.cc 
echo getline       ; $CMP getline.cc       
echo file_selector ; $CMP file_selector.cc 
echo history       ; $CMP history.cc       
echo craft         ; $CMP craft.cc            

$GPP xtimer.o option_menu.o setupedit.o robot.o land.o ship.o building.o dir.o object_handler.o pic.o player.o field.o ilfield.o xbm.o cmap_edit.o cmap.o ppm.o compress.o table.o xmath.o io.o cry.o win.o dial.o multi_dial.o menu.o xsystem.o xfile.o ppm_handler.o errorhandling.o paramreader.o pattern_match.o objects.o xstring.o id_handler.o color_trans.o masks.o buttons.o lru.o scroller.o selector.o cmap_selector.o getline.o file_selector.o history.o craft.o $LFLAGS -o craft





  
  

